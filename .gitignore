# --- Python (engine/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
engine/build/
engine/dist-sidecar/
engine/build-sidecar/
engine/*.spec

# --- Node / frontend (desktop/) ---
node_modules/
desktop/dist/
.vite/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tsbuildinfo
desktop/vite.config.js
desktop/vite.config.d.ts

# --- Rust / Tauri (desktop/src-tauri/) ---
desktop/src-tauri/target/
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep
# NOTE: Cargo.lock is intentionally NOT ignored. This is a binary
# application (the Tauri shell), not a library, so the lockfile is
# committed for reproducible builds across contributors/CI — ignoring it
# was a bug: it meant every fresh clone re-resolved to the newest crates,
# which is exactly what breaks the build on an older (e.g. apt-provided)
# Rust toolchain that doesn't support the "edition2024" Cargo feature.

# --- Crossmith runtime artifacts ---
.crossmith/
*.crossmith-cache/
crossmith-builds/
*.db
*.sqlite3

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.swp

# --- Secrets — never commit these ---
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
